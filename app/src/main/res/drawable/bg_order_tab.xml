<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_surface_container_high" />
            <stroke
                android:width="1dp"
                android:color="@color/md_on_surface_variant" />
            <corners android:radius="@dimen/corner_medium" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/md_surface_container_high" />
            <stroke
                android:width="1dp"
                android:color="@color/md_outline_variant" />
            <corners android:radius="@dimen/corner_medium" />
        </shape>
    </item>
</selector>
