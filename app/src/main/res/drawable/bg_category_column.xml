        android:layout_height="match_parent"
        android:layout_gravity="right"
        android:background="@color/divider" />

    <!-- Surface background -->
    <shape android:shape="rectangle">
        <solid android:color="@color/md_surface_container" />
    </shape>
</layer-list>
