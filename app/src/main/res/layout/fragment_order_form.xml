<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_surface">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineProductEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.66" />

    <!-- Vertical category rail -->
    <LinearLayout
        android:id="@+id/categoryRail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/md_background"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineCategoryEnd"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="10dp"
            android:text="@string/categories"
            android:textAppearance="@style/TextAppearance.KopiHarmoni.TitleMedium"
            android:textColor="@color/text_primary" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categoryChipsRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <ProgressBar
            android:id="@+id/categoryProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/loading"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCategoryEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.16" />

    <!-- Product area: search bar, category title and adaptive product grid -->
    <LinearLayout
        android:id="@+id/productColumn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/md_surface"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineProductEnd"
        app:layout_constraintStart_toEndOf="@id/guidelineCategoryEnd"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.KopiHarmoni.InputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/search_product"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/text_secondary"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/productSearchInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="@dimen/text_caption" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewModeButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/grid_view"
                app:backgroundTint="@color/md_surface"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_grid"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/accent"
                app:strokeColor="@color/md_outline" />
        </LinearLayout>

        <TextView
            android:id="@+id/categoryTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:text="@string/all_categories"
            android:textAppearance="@style/TextAppearance.KopiHarmoni.TitleMedium"
            android:textColor="@color/text_primary" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/productsRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="@dimen/spacing_xsmall"
            android:paddingTop="@dimen/spacing_xsmall"
            android:paddingEnd="@dimen/spacing_xsmall"
            android:paddingBottom="@dimen/spacing_xsmall" />

        <include
            android:id="@+id/productsEmptyView"
            layout="@layout/view_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Product loading — separate from category & submit -->
        <ProgressBar
            android:id="@+id/productProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/loading"
            android:visibility="gone" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:padding="@dimen/spacing_small"
            android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelSmall"
            android:textColor="@color/status_void"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Order summary column (66% -> end) — fixed 34% width -->
    <LinearLayout
        android:id="@+id/orderColumn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_order_summary_column"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guidelineProductEnd"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/orderSummaryHeader"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_order_summary_header"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/order_summary"
                android:src="@drawable/ic_receipt"
                app:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/order_summary"
                android:textAppearance="@style/TextAppearance.KopiHarmoni.TitleMedium"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/cartCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_qty_badge"
                android:gravity="center"
                android:minWidth="24dp"
                android:minHeight="24dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="0"
                android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelSmall"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:visibility="gone"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- Order Type — moved outside Customer Detail, pinned to top of Order Summary (always visible) -->
        <LinearLayout
            android:id="@+id/orderTypeTopContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md_surface_container"
            android:elevation="1dp"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/orderTypeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:checkedButton="@id/dineInButton"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dineInButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/dine_in"
                    android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelLarge"
                    android:textColor="@color/order_type_text"
                    app:backgroundTint="@color/order_type_bg"
                    app:icon="@drawable/ic_dine_in"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconTint="@color/order_type_text"
                    app:strokeColor="@color/md_outline"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/takeawayButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/takeaway"
                    android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelLarge"
                    android:textColor="@color/order_type_text"
                    app:backgroundTint="@color/order_type_bg"
                    app:icon="@drawable/ic_takeaway"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconTint="@color/order_type_text"
                    app:strokeColor="@color/md_outline"
                    app:strokeWidth="1dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- Flexible cart area - FrameLayout holds either RecyclerView or empty view -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/cartRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="@dimen/spacing_xsmall"
                android:paddingBottom="@dimen/spacing_xsmall" />

            <include
                android:id="@+id/cartEmptyView"
                layout="@layout/view_empty_cart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Compact collapsible checkout panel — reduced for narrower 32% column -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/checkoutScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:isScrollContainer="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/md_surface_container"
                android:orientation="vertical"
                android:paddingTop="@dimen/spacing_xsmall"
                android:paddingBottom="@dimen/spacing_xsmall">

                <!-- Collapsible checkout header — enlarged tap target (48dp M3 min) -->
                <LinearLayout
                    android:id="@+id/checkoutDetailsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/checkoutDetailsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Customer &amp; Details"
                        android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelLarge"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/checkoutDetailsSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelSmall"
                        android:textColor="@color/text_secondary"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/checkoutExpandIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/expand"
                        android:tooltipText="@string/expand"
                        android:src="@drawable/ic_add"
                        app:tint="@color/text_secondary" />

                </LinearLayout>

                <!-- Inputs - collapsible — compact 12dp -->
                <LinearLayout
                    android:id="@+id/checkoutInputsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/customerInputLayout"
                        style="@style/Widget.KopiHarmoni.InputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/customer_name"
                        app:endIconMode="custom"
                        app:endIconDrawable="@drawable/ic_search"
                        app:endIconContentDescription="@string/customer">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/customerInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="username"
                            android:imeOptions="actionNext"
                            android:inputType="text|textCapWords"
                            android:maxLines="1"
                            android:minHeight="48dp"
                            android:nextFocusDown="@id/discountInput"
                            android:nextFocusForward="@id/discountInput"
                            android:textAppearance="@style/TextAppearance.KopiHarmoni.BodyMedium"
                            tools:ignore="VisualLintTextFieldSize" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.KopiHarmoni.InputLayout"
                        android:layout_width="@dimen/of_discount_input_width"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xsmall"
                        android:hint="@string/discount"
                        app:suffixText="Rp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/discountInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="numberDecimal"
                            android:minHeight="48dp"
                            android:nextFocusDown="@id/remarkInput"
                            android:nextFocusForward="@id/remarkInput"
                            android:nextFocusUp="@id/customerInput"
                            android:selectAllOnFocus="true"
                            android:text="0"
                            android:textAppearance="@style/TextAppearance.KopiHarmoni.BodyMedium"
                            tools:ignore="HardcodedText" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.KopiHarmoni.InputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xsmall"
                        android:hint="@string/additional_notes">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/remarkInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLines="2"
                            android:minHeight="48dp"
                            android:nextFocusUp="@id/discountInput"
                            android:textAppearance="@style/TextAppearance.KopiHarmoni.BodyMedium" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Fixed checkout footer: totals and actions never scroll away -->
        <LinearLayout
            android:id="@+id/checkoutFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md_surface"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:minHeight="30dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sub_total"
                    android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelMedium"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/subtotalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp0"
                    android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelLarge"
                    android:textColor="@color/text_primary"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:minHeight="28dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/discount"
                    android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelMedium"
                    android:textColor="@color/status_void" />

                <TextView
                    android:id="@+id/discountTotalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp0"
                    android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelLarge"
                    android:textColor="@color/status_void"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_total_highlight"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/total"
                    android:textAppearance="@style/TextAppearance.KopiHarmoni.TitleMedium"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/totalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp0"
                    android:textAppearance="@style/TextAppearance.KopiHarmoni.Total"
                    android:textColor="@color/accent"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/printButton"
                    style="@style/Widget.KopiHarmoni.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/height_button"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/print"
                    android:textColor="@color/accent"
                    android:stateListAnimator="@animator/button_press_outlined"
                    app:icon="@drawable/ic_printer"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconTint="@color/accent"
                    app:strokeColor="@color/accent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/confirmButton"
                    style="@style/Widget.KopiHarmoni.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/height_button"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1.5"
                    android:minHeight="48dp"
                    android:text="@string/confirm"
                    android:textColor="@color/white"
                    android:stateListAnimator="@animator/button_press"
                    app:backgroundTint="@color/accent"
                    app:icon="@drawable/ic_check_circle"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconTint="@color/white" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/submitProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/loading"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
