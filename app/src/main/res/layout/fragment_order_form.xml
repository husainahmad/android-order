<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_surface">

    <!-- Guidelines: 17% category / 48% product / 35% order summary — balanced, order enlarged -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCategoryEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.17" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineProductEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.65" />

    <!-- Category column (Guideline 0 -> 0.20) -->
    <LinearLayout
        android:id="@+id/categoryColumn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_category_column"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineCategoryEnd"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_section_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <View
                android:layout_width="4dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_header_accent"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/categories"
                android:textAppearance="@style/TextAppearance.KopiHarmoni.TitleSmall"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categoryRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="@dimen/spacing_small"
            android:paddingTop="@dimen/spacing_xsmall"
            android:paddingEnd="@dimen/spacing_small"
            android:paddingBottom="@dimen/spacing_xsmall" />

        <ProgressBar
            android:id="@+id/categoryProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/loading"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Product list column (0.17 -> 0.65) — 48% width -->
    <LinearLayout
        android:id="@+id/productColumn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/md_surface"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineProductEnd"
        app:layout_constraintStart_toEndOf="@id/guidelineCategoryEnd"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_section_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <View
                android:layout_width="4dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_header_accent"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/products_label"
                android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelMedium"
                android:textColor="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:alpha="0.6"
                android:text="•"
                android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelSmall"
                android:textColor="@color/text_secondary"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/categoryTitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/all_categories"
                android:textAppearance="@style/TextAppearance.KopiHarmoni.TitleSmall"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/productsRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="@dimen/spacing_xsmall"
            android:paddingTop="@dimen/spacing_xsmall"
            android:paddingEnd="@dimen/spacing_xsmall"
            android:paddingBottom="@dimen/spacing_xsmall" />

        <include
            android:id="@+id/productsEmptyView"
            layout="@layout/view_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Product loading — separate from category & submit -->
        <ProgressBar
            android:id="@+id/productProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/loading"
            android:visibility="gone" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:padding="@dimen/spacing_small"
            android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelSmall"
            android:textColor="@color/status_void"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Order summary column (0.65 -> end) — 35% width -->
    <LinearLayout
        android:id="@+id/orderColumn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_order_summary_column"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guidelineProductEnd"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/orderSummaryHeader"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_order_summary_header"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <View
                android:layout_width="4dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_header_accent"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/order_summary"
                android:textAppearance="@style/TextAppearance.KopiHarmoni.TitleSmall"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/cartCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_qty_badge"
                android:gravity="center"
                android:minWidth="24dp"
                android:minHeight="24dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="0"
                android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelSmall"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:visibility="gone"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- Order Type — moved outside Customer Detail, pinned to top of Order Summary (always visible) -->
        <LinearLayout
            android:id="@+id/orderTypeTopContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md_surface_container"
            android:elevation="1dp"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/order_type"
                android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelSmall"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/orderTypeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:checkedButton="@id/dineInButton"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dineInButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/dine_in"
                    android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelLarge"
                    app:icon="@drawable/ic_dine_in"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:strokeColor="@color/accent"
                    app:strokeWidth="1.5dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/takeawayButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/takeaway"
                    android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelLarge"
                    app:icon="@drawable/ic_takeaway"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:strokeColor="@color/accent"
                    app:strokeWidth="1.5dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- Flexible cart area - FrameLayout holds either RecyclerView or empty view -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/cartRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="@dimen/spacing_xsmall"
                android:paddingBottom="@dimen/spacing_xsmall" />

            <include
                android:id="@+id/cartEmptyView"
                layout="@layout/view_empty_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Compact collapsible checkout panel — reduced for narrower 32% column -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/checkoutScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:isScrollContainer="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/md_surface_container"
                android:orientation="vertical"
                android:paddingTop="@dimen/spacing_xsmall"
                android:paddingBottom="@dimen/spacing_xsmall">

                <!-- Collapsible checkout header — enlarged tap target (48dp M3 min) -->
                <LinearLayout
                    android:id="@+id/checkoutDetailsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/checkoutDetailsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Customer &amp; Details"
                        android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelLarge"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/checkoutDetailsSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelSmall"
                        android:textColor="@color/text_secondary"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/checkoutExpandIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/expand"
                        android:tooltipText="@string/expand"
                        android:src="@drawable/ic_add"
                        app:tint="@color/text_secondary" />

                </LinearLayout>

                <!-- Inputs - collapsible — compact 12dp -->
                <LinearLayout
                    android:id="@+id/checkoutInputsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.KopiHarmoni.InputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/customer_name">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/customerInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="username"
                            android:imeOptions="actionNext"
                            android:inputType="text|textCapWords"
                            android:maxLines="1"
                            android:minHeight="48dp"
                            android:nextFocusDown="@id/discountInput"
                            android:nextFocusForward="@id/discountInput"
                            android:textAppearance="@style/TextAppearance.KopiHarmoni.BodyMedium"
                            tools:ignore="VisualLintTextFieldSize" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.KopiHarmoni.InputLayout"
                        android:layout_width="@dimen/of_discount_input_width"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xsmall"
                        android:hint="@string/discount"
                        app:suffixText="Rp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/discountInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="numberDecimal"
                            android:minHeight="48dp"
                            android:nextFocusDown="@id/remarkInput"
                            android:nextFocusForward="@id/remarkInput"
                            android:nextFocusUp="@id/customerInput"
                            android:selectAllOnFocus="true"
                            android:text="0"
                            android:textAppearance="@style/TextAppearance.KopiHarmoni.BodyMedium"
                            tools:ignore="HardcodedText" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.KopiHarmoni.InputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xsmall"
                        android:hint="@string/additional_notes">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/remarkInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLines="2"
                            android:minHeight="48dp"
                            android:nextFocusUp="@id/discountInput"
                            android:textAppearance="@style/TextAppearance.KopiHarmoni.BodyMedium" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Divider above totals — tight -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@color/divider"
                    android:importantForAccessibility="no" />

                <!-- Subtotal — tight -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/sub_total"
                        android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelMedium"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/subtotalText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp.0"
                        android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelLarge"
                        android:textColor="@color/text_primary"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <!-- Total - prominent — tight -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_total_highlight"
                    android:gravity="center_vertical"
                    android:minHeight="36dp"
                    android:orientation="horizontal"
                    android:padding="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/total"
                        android:textAppearance="@style/TextAppearance.KopiHarmoni.TitleMedium"
                        android:textColor="@color/primary" />

                    <TextView
                        android:id="@+id/totalText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp.0"
                        android:textAppearance="@style/TextAppearance.KopiHarmoni.TitleLarge"
                        android:textColor="@color/primary"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <!-- Buttons - compact for narrower column -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xsmall"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/confirmButton"
                        style="@style/Widget.KopiHarmoni.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/height_button"
                        android:layout_marginEnd="@dimen/spacing_small"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:text="@string/confirm"
                        android:textColor="@color/white"
                        android:stateListAnimator="@animator/button_press"
                        app:backgroundTint="@color/accent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/printButton"
                        style="@style/Widget.KopiHarmoni.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/height_button"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:text="@string/print"
                        android:textColor="@color/blue_action"
                        android:stateListAnimator="@animator/button_press_outlined"
                        app:strokeColor="@color/blue_action" />
                </LinearLayout>

                <!-- Submit (confirm order) progress — separate from category/product to avoid race -->
                <ProgressBar
                    android:id="@+id/submitProgressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:contentDescription="@string/loading"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
