<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_stepper"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <TextView
                android:id="@+id/summaryTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/order_summary"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_dialog_subtitle"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/customerSummaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_dialog_body" />

            <TextView
                android:id="@+id/discountSummaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_dialog_body" />

            <TextView
                android:id="@+id/noteSummaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_dialog_body" />
        </LinearLayout>

<TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_payment_method"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_payment_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/orderInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_payment_subtitle" />

            <LinearLayout
                android:id="@+id/paymentSelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/qrCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_payment_option"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <ImageView
                        android:id="@+id/qrImage"
                        android:layout_width="@dimen/size_payment_icon"
                        android:layout_height="@dimen/height_button_small"
                        android:contentDescription="@string/qris"
                        android:src="@drawable/ic_qr"
                        android:tint="@color/accent" />

                    <TextView
                        android:id="@+id/qrLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/qris"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_dialog_label"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_payment_option"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/cardImage"
                        android:layout_width="@dimen/size_payment_icon"
                        android:layout_height="@dimen/height_button_small"
                        android:contentDescription="@string/card"
                        android:src="@drawable/ic_card"
                        android:tint="@color/gray_button" />

                    <TextView
                        android:id="@+id/cardLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/card"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_dialog_label" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cashCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_payment_option"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/cashImage"
                        android:layout_width="@dimen/size_payment_icon"
                        android:layout_height="@dimen/height_button_small"
                        android:contentDescription="@string/cash"
                        android:src="@drawable/ic_cash"
                        android:tint="@color/gray_button" />

                    <TextView
                        android:id="@+id/cashLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/cash"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_dialog_label" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cashPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/cashTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CASH PAYMENT"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_payment_subtitle"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TOTAL"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_payment_cash_label" />

                        <TextView
                            android:id="@+id/cashTotalText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_payment_cash_amount"
                            android:textStyle="bold" />

                        <GridLayout
                            android:id="@+id/cashGrid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:columnCount="3">

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/height_button_small"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill_horizontal"
                                android:layout_margin="3dp"
                                android:tag="1000"
                                android:text="1.000"
                                android:textSize="@dimen/text_size_dialog_button"
                                android:stateListAnimator="@animator/button_press_outlined"
                                app:cornerRadius="10dp" />

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/height_button_small"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill_horizontal"
                                android:layout_margin="3dp"
                                android:tag="2000"
                                android:text="2.000"
                                android:textSize="@dimen/text_size_dialog_button"
                                android:stateListAnimator="@animator/button_press_outlined"
                                app:cornerRadius="10dp" />

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/height_button_small"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill_horizontal"
                                android:layout_margin="3dp"
                                android:tag="5000"
                                android:text="5.000"
                                android:textSize="@dimen/text_size_dialog_button"
                                android:stateListAnimator="@animator/button_press_outlined"
                                app:cornerRadius="10dp" />

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/height_button_small"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill_horizontal"
                                android:layout_margin="3dp"
                                android:tag="10000"
                                android:text="10.000"
                                android:textSize="@dimen/text_size_dialog_button"
                                android:stateListAnimator="@animator/button_press_outlined"
                                app:cornerRadius="10dp" />

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/height_button_small"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill_horizontal"
                                android:layout_margin="3dp"
                                android:tag="20000"
                                android:text="20.000"
                                android:textSize="@dimen/text_size_dialog_button"
                                android:stateListAnimator="@animator/button_press_outlined"
                                app:cornerRadius="10dp" />

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/height_button_small"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill_horizontal"
                                android:layout_margin="3dp"
                                android:tag="50000"
                                android:text="50.000"
                                android:textSize="@dimen/text_size_dialog_button"
                                android:stateListAnimator="@animator/button_press_outlined"
                                app:cornerRadius="10dp" />

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/height_button_small"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill_horizontal"
                                android:layout_margin="3dp"
                                android:tag="100000"
                                android:text="100.000"
                                android:textSize="@dimen/text_size_dialog_button"
                                android:stateListAnimator="@animator/button_press_outlined"
                                app:cornerRadius="10dp" />

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/height_button_small"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill_horizontal"
                                android:layout_margin="3dp"
                                android:tag="200000"
                                android:text="200.000"
                                android:textSize="@dimen/text_size_dialog_button"
                                android:stateListAnimator="@animator/button_press_outlined"
                                app:cornerRadius="10dp" />

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/height_button_small"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill_horizontal"
                                android:layout_margin="3dp"
                                android:tag="500000"
                                android:text="500.000"
                                android:textSize="@dimen/text_size_dialog_button"
                                android:stateListAnimator="@animator/button_press_outlined"
                                app:cornerRadius="10dp" />
                        </GridLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/clearButton"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/height_button_small"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:text="CLEAR"
                                android:textSize="@dimen/text_size_dialog_button"
                                android:stateListAnimator="@animator/button_press_outlined"
                                app:cornerRadius="10dp"
                                app:strokeColor="@color/status_void" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/exactButton"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/height_button_small"
                                android:layout_weight="1"
                                android:text="EXACT"
                                android:textSize="@dimen/text_size_dialog_button"
                                android:stateListAnimator="@animator/button_press"
                                app:backgroundTint="@color/accent"
                                app:cornerRadius="10dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UANG DITERIMA"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_payment_cash_label" />

                        <TextView
                            android:id="@+id/cashReceivedText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_payment_cash_amount"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="KEMBALIAN"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_payment_cash_label" />

                        <TextView
                            android:id="@+id/cashChangeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/accent"
                            android:textSize="@dimen/text_size_payment_cash_amount"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bayarButton"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/height_payment_action_button"
                            android:layout_marginTop="16dp"
                            android:text="BAYAR"
                            android:textSize="@dimen/text_size_payment_button"
                            android:stateListAnimator="@animator/button_press"
                            app:backgroundTint="@color/accent"
                            app:cornerRadius="12dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/payButton"
            style="@style/Widget.KopiHarmoni.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/height_payment_action_button"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
                            android:text="@string/pay"
                            android:textSize="@dimen/text_size_payment_button"
                            android:stateListAnimator="@animator/button_press"
                            app:backgroundTint="@color/accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/closeButton"
            style="@style/Widget.KopiHarmoni.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="@dimen/height_payment_action_button"
            android:layout_weight="1"
                            android:text="@string/close"
                            android:textSize="@dimen/text_size_payment_button"
                            android:stateListAnimator="@animator/button_press_outlined"
                            app:strokeColor="@color/gray_button" />
    </LinearLayout>
</LinearLayout>
