<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sidebar"
    android:layout_width="@dimen/sidebar_width"
    android:layout_height="match_parent"
    android:background="@color/sidebar_bg"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="8dp"
    android:paddingEnd="6dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/sidebarOrders"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_sidebar_nav"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/orders"
            android:duplicateParentState="true"
            android:src="@drawable/ic_empty_cart"
            app:tint="@color/sidebar_nav_icon" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/orders"
            android:textColor="@color/sidebar_nav_text"
            android:textSize="@dimen/text_small"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sidebarMenu"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_sidebar_nav"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/nav_menu"
            android:duplicateParentState="true"
            android:src="@drawable/ic_category_default"
            app:tint="@color/sidebar_nav_icon" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/nav_menu"
            android:textColor="@color/sidebar_nav_text"
            android:textSize="@dimen/text_small" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sidebarStore"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_sidebar_nav"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/nav_store"
            android:duplicateParentState="true"
            android:src="@drawable/ic_store"
            app:tint="@color/sidebar_nav_icon" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/nav_store"
            android:textColor="@color/sidebar_nav_text"
            android:textSize="@dimen/text_small" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sidebarSettings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_sidebar_nav"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/nav_settings"
            android:duplicateParentState="true"
            android:src="@drawable/ic_settings"
            app:tint="@color/sidebar_nav_icon" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/nav_settings"
            android:textColor="@color/sidebar_nav_text"
            android:textSize="@dimen/text_small" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#22FFFFFF"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="4dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/sidebar_brand"
            android:src="@drawable/ic_logo_cup"
            app:tint="@color/accent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/sidebar_brand"
            android:textColor="@color/sidebar_text"
            android:textSize="@dimen/text_size_badge"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sidebarStoreName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/sidebar_brand"
            android:textColor="@color/sidebar_text_muted"
            android:textSize="@dimen/text_size_badge" />
    </LinearLayout>
</LinearLayout>
