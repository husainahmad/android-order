<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_surface"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/productNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_dialog_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/productSubtitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <ImageView
            android:id="@+id/closeButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_category_circle"
            android:contentDescription="@string/close"
            android:padding="9dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/md_outline_variant" />

    <!-- Scrollable body -->
    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Variant selection (only when more than one SKU) -->
            <TextView
                android:id="@+id/variantTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="20dp"
                android:text="@string/select_variant"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_dialog_subtitle"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/skuContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/customizationContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="20dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/customizationHintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="20dp"
                android:text="@string/customize_select_variant_hint"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_small"
                android:visibility="gone" />

            <!-- Kitchen note -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                android:text="@string/kitchen_note"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_dialog_subtitle"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.KopiHarmoni.InputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp"
                android:hint="@string/kitchen_note_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/noteInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="3"
                    android:minHeight="52dp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/md_outline_variant" />

    <!-- Footer: quantity + add -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_stepper"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/minusButton"
                style="@style/Widget.KopiHarmoni.QtyButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/remove"
                android:minWidth="44dp"
                android:minHeight="44dp"
                android:text=""
                app:backgroundTint="@color/md_surface_container"
                app:icon="@drawable/ic_remove"
                app:iconGravity="textStart"
                app:iconTint="@color/text_secondary"
                app:strokeColor="@color/md_outline"
                app:strokeWidth="1dp" />

            <TextView
                android:id="@+id/quantityText"
                android:layout_width="40dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.KopiHarmoni.TitleMedium"
                android:textColor="@color/text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/plusButton"
                style="@style/Widget.KopiHarmoni.QtyButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/add"
                android:minWidth="44dp"
                android:minHeight="44dp"
                android:text=""
                app:backgroundTint="@color/accent"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconTint="@color/white" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addButton"
            style="@style/Widget.KopiHarmoni.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/height_payment_action_button"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/add_to_order"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
