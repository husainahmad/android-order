<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_option_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="8dp">

    <ImageView
        android:id="@+id/optionCheck"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/selected"
        android:src="@drawable/ic_check_box_outline" />

    <TextView
        android:id="@+id/optionNameText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.KopiHarmoni.BodyMedium"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/optionPriceText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_small" />

    <LinearLayout
        android:id="@+id/optionQtyContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/optionMinusButton"
            style="@style/Widget.KopiHarmoni.QtyButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/remove"
            android:minWidth="36dp"
            android:minHeight="36dp"
            android:text=""
            app:backgroundTint="@color/md_surface_container"
            app:icon="@drawable/ic_remove"
            app:iconGravity="textStart"
            app:iconTint="@color/text_secondary"
            app:strokeColor="@color/md_outline"
            app:strokeWidth="1dp" />

        <TextView
            android:id="@+id/optionQuantityText"
            android:layout_width="26dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelLarge"
            android:textColor="@color/text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/optionPlusButton"
            style="@style/Widget.KopiHarmoni.QtyButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/add"
            android:minWidth="36dp"
            android:minHeight="36dp"
            android:text=""
            app:backgroundTint="@color/accent"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />
    </LinearLayout>
</LinearLayout>
