<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_surface"
    android:orientation="vertical">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/ordersToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_order_summary_header"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingEnd="@dimen/spacing_medium">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/orders"
            android:textAppearance="@style/TextAppearance.KopiHarmoni.TitleLarge"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/orderCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelLarge"
            android:textColor="@color/white"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Orders table (top, expands) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Column header — weights match item_order.xml LinearLayout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_table_header"
            android:background="@color/md_surface_container"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_small"
            android:paddingEnd="@dimen/spacing_small">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="@string/order_no"
                android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelLarge"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:text="@string/date"
                android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelLarge"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="@string/customer"
                android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelLarge"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:text="@string/type"
                android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelLarge"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.7"
                android:text="@string/payment"
                android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelLarge"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:text="@string/status"
                android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelLarge"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.9"
                android:gravity="end"
                android:text="@string/sub_total"
                android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelLarge"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:gravity="end"
                android:text="@string/discount"
                android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelLarge"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:gravity="end"
                android:text="@string/total"
                android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelLarge"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_thickness"
            android:background="@color/divider" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ordersRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <include
            android:id="@+id/ordersEmptyView"
            layout="@layout/view_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/loading"
            android:visibility="gone" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:padding="12dp"
            android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelMedium"
            android:textColor="@color/status_void"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Action buttons (footer) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_surface_container"
        android:orientation="horizontal"
        android:padding="10dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dailyReportButton"
        style="@style/Widget.KopiHarmoni.Button.Outlined"
        android:layout_width="0dp"
        android:layout_height="@dimen/height_tab"
        android:layout_marginEnd="@dimen/spacing_small"
        android:layout_weight="1"
        android:minHeight="48dp"
        android:text="@string/daily_report"
        android:textAllCaps="false"
        android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelMedium"
        android:stateListAnimator="@animator/button_press_outlined"
        app:strokeColor="@color/primary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/salesReportButton"
        style="@style/Widget.KopiHarmoni.Button.Outlined"
        android:layout_width="0dp"
        android:layout_height="@dimen/height_tab"
        android:layout_marginEnd="@dimen/spacing_small"
        android:layout_weight="1"
        android:minHeight="48dp"
        android:text="@string/sales_report"
        android:textAllCaps="false"
        android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelMedium"
        android:stateListAnimator="@animator/button_press_outlined"
        app:strokeColor="@color/primary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/settlementButton"
        style="@style/Widget.KopiHarmoni.Button.Outlined"
        android:layout_width="0dp"
        android:layout_height="@dimen/height_tab"
        android:layout_marginEnd="@dimen/spacing_small"
        android:layout_weight="1"
        android:minHeight="48dp"
        android:text="@string/settlement"
        android:textAllCaps="false"
        android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelMedium"
        android:stateListAnimator="@animator/button_press_outlined"
        app:strokeColor="@color/primary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/refreshButton"
        style="@style/Widget.KopiHarmoni.Button.Outlined"
        android:layout_width="0dp"
        android:layout_height="@dimen/height_tab"
        android:layout_marginEnd="@dimen/spacing_small"
        android:layout_weight="1"
        android:icon="@drawable/ic_refresh"
        android:minHeight="48dp"
        android:text="@string/refresh"
        android:textAllCaps="false"
        android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelMedium"
        android:stateListAnimator="@animator/button_press_outlined"
        app:strokeColor="@color/primary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/settingsButton"
        style="@style/Widget.KopiHarmoni.Button.Outlined"
        android:layout_width="0dp"
        android:layout_height="@dimen/height_tab"
        android:layout_marginEnd="@dimen/spacing_small"
        android:layout_weight="1"
        android:icon="@drawable/ic_menu"
        android:minHeight="48dp"
        android:text="@string/menu_settings"
        android:textAllCaps="false"
        android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelMedium"
        android:stateListAnimator="@animator/button_press_outlined"
        app:strokeColor="@color/primary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/logoutButton"
        style="@style/Widget.KopiHarmoni.Button.Outlined"
        android:layout_width="0dp"
        android:layout_height="@dimen/height_tab"
        android:layout_weight="1"
        android:minHeight="48dp"
        android:text="@string/logout"
        android:textAllCaps="false"
        android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelMedium"
        android:stateListAnimator="@animator/button_press_outlined"
        app:strokeColor="@color/status_void" />
    </LinearLayout>

</LinearLayout>
