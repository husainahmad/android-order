<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/md_background"
        android:orientation="vertical">

        <!-- Page header + right-aligned filters -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="18dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/orders"
                    android:textAppearance="@style/TextAppearance.KopiHarmoni.HeadlineSmall"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/orders_subtitle"
                    android:textAppearance="@style/TextAppearance.KopiHarmoni.BodyMedium"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/orderFilterGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/filterAll"
                        style="@style/Widget.KopiHarmoni.FilterChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/filter_all" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/filterPaid"
                        style="@style/Widget.KopiHarmoni.FilterChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_paid" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/filterConfirmed"
                        style="@style/Widget.KopiHarmoni.FilterChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_confirmed" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/filterVoid"
                        style="@style/Widget.KopiHarmoni.FilterChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_void" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Table card fills the space above the bottom action bar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="10dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/md_surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/md_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Column header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_table_header"
                    android:background="@color/md_surface_container_low"
                    android:gravity="center_vertical"
                    android:minHeight="44dp"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.45"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/order_no"
                        android:textAppearance="@style/TextAppearance.KopiHarmoni.TableHeader" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/date_time"
                        android:textAppearance="@style/TextAppearance.KopiHarmoni.TableHeader" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.15"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/customer"
                        android:textAppearance="@style/TextAppearance.KopiHarmoni.TableHeader" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.9"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/type"
                        android:textAppearance="@style/TextAppearance.KopiHarmoni.TableHeader" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.95"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/payment"
                        android:textAppearance="@style/TextAppearance.KopiHarmoni.TableHeader" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.95"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/status"
                        android:textAppearance="@style/TextAppearance.KopiHarmoni.TableHeader" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="1"
                        android:text="@string/sub_total"
                        android:textAppearance="@style/TextAppearance.KopiHarmoni.TableHeader" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.9"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="1"
                        android:text="@string/discount"
                        android:textAppearance="@style/TextAppearance.KopiHarmoni.TableHeader" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.05"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="1"
                        android:text="@string/total"
                        android:textAppearance="@style/TextAppearance.KopiHarmoni.TableHeader" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:importantForAccessibility="no" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/ordersRecycler"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp" />

                    <include
                        android:id="@+id/ordersEmptyView"
                        layout="@layout/view_empty_orders"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:contentDescription="@string/loading"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/errorText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:padding="8dp"
                    android:textAppearance="@style/TextAppearance.KopiHarmoni.LabelMedium"
                    android:textColor="@color/status_void"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Fixed bottom actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md_surface"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dailyReportButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/daily_report"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_small"
                    app:backgroundTint="@color/md_surface"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_report_daily"
                    app:iconGravity="top"
                    app:iconPadding="4dp"
                    app:iconTint="@color/text_primary"
                    app:strokeColor="@color/md_outline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/salesReportButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/sales_report"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_small"
                    app:backgroundTint="@color/md_surface"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_report_sales"
                    app:iconGravity="top"
                    app:iconPadding="4dp"
                    app:iconTint="@color/text_primary"
                    app:strokeColor="@color/md_outline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settlementButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/settlement"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_small"
                    app:backgroundTint="@color/md_surface"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_settlement"
                    app:iconGravity="top"
                    app:iconPadding="4dp"
                    app:iconTint="@color/text_primary"
                    app:strokeColor="@color/md_outline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/refreshButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/refresh"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_small"
                    app:backgroundTint="@color/md_surface"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_refresh"
                    app:iconGravity="top"
                    app:iconPadding="4dp"
                    app:iconTint="@color/text_primary"
                    app:strokeColor="@color/md_outline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/menu_settings"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_small"
                    app:backgroundTint="@color/md_surface"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_settings"
                    app:iconGravity="top"
                    app:iconPadding="4dp"
                    app:iconTint="@color/text_primary"
                    app:strokeColor="@color/md_outline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/logoutButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/logout"
                    android:textAllCaps="false"
                    android:textColor="@color/status_void"
                    android:textSize="@dimen/text_small"
                    app:backgroundTint="@color/md_surface"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_logout"
                    app:iconGravity="top"
                    app:iconPadding="4dp"
                    app:iconTint="@color/status_void"
                    app:strokeColor="@color/status_void" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
