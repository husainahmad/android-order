<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- SKU Name -->
    <TextView
        android:id="@+id/skuNameText"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="12dp"
        android:drawableStart="@drawable/ic_bullet"
        android:drawablePadding="8dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption"
        android:textStyle="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/qtyContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Quantity Controls Pill -->
    <LinearLayout
        android:id="@+id/qtyContainer"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:background="@drawable/bg_qty_pill"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/lineTotalText"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/minusButton"
            style="@style/Widget.KopiHarmoni.QtyButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/remove"
            android:text=""
            android:stateListAnimator="@animator/button_press_outlined"
            app:backgroundTint="@color/md_surface_container"
            app:icon="@drawable/ic_remove"
            app:iconGravity="textStart"
            app:iconTint="@color/text_secondary"
            app:strokeColor="@color/md_outline"
            app:strokeWidth="1dp" />

        <TextView
            android:id="@+id/quantityText"
            android:layout_width="52dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/plusButton"
            style="@style/Widget.KopiHarmoni.QtyButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/add"
            android:text=""
            android:stateListAnimator="@animator/button_press"
            app:backgroundTint="@color/accent"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />
    </LinearLayout>

    <!-- Line Total -->
    <TextView
        android:id="@+id/lineTotalText"
        android:layout_width="96dp"
        android:layout_height="44dp"
        android:gravity="center_vertical|end"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>